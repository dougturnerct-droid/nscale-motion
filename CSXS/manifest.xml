<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nscale Motion — After Effects CEP extension bundle.
  One bundle, two panels: the main panel and the compact bar.
  Bump ExtensionBundleVersion and both Extension Version values for each release.
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   Version="7.0"
                   ExtensionBundleId="com.nscale.motion"
                   ExtensionBundleVersion="2.5.2"
                   ExtensionBundleName="Nscale Motion">

  <ExtensionList>
    <Extension Id="com.nscale.motion.panel" Version="2.5.2"/>
    <Extension Id="com.nscale.motion.bar" Version="2.5.2"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[18.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>

    <!-- Main panel: Window > Extensions > Nscale Motion -->
    <Extension Id="com.nscale.motion.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node.js inside the panel, so file reads/writes can move out of ExtendScript
                 and users stop needing "Allow Scripts to Write Files and Access Network". -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Nscale Motion</Menu>
          <Geometry>
            <Size><Height>760</Height><Width>440</Width></Size>
            <MinSize><Height>420</Height><Width>320</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>1000</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- Compact bar: Window > Extensions > Nscale Bar -->
    <Extension Id="com.nscale.motion.bar">
      <DispatchInfo>
        <Resources>
          <MainPath>./bar.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Nscale Bar</Menu>
          <Geometry>
            <Size><Height>48</Height><Width>760</Width></Size>
            <MinSize><Height>40</Height><Width>48</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>2400</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
