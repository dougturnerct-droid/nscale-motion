<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nscale Motion for Premiere Pro — places the Nscale .mogrt templates with the editor's text.
  Separate bundle from the After Effects panel so each app installs only what it needs.
  Bump ExtensionBundleVersion and the Extension Version together for each release.
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   Version="7.0"
                   ExtensionBundleId="com.nscale.motion.ppro"
                   ExtensionBundleVersion="1.4.0"
                   ExtensionBundleName="Nscale Motion for Premiere">

  <ExtensionList>
    <Extension Id="com.nscale.motion.ppro.panel" Version="1.4.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO = Premiere Pro. 22.0 = Premiere 2022. -->
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.nscale.motion.ppro.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./ppro/index.html</MainPath>
          <ScriptPath>./ppro/jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Nscale Motion</Menu>
          <Geometry>
            <Size><Height>560</Height><Width>380</Width></Size>
            <MinSize><Height>320</Height><Width>280</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>1000</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
